{
  "name": "cv-manager",
  "productName": "CV Manager",
  "version": "0.1.0",
  "description": "Crea tu CV a partir de plantillas y expórtalo a PDF.",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "start": "electron .",
    "dist": "pnpm build && electron-builder --mac",
    "reparar:electron": "node scripts/instalar-electron.mjs --force",
    "postinstall": "node scripts/instalar-electron.mjs"
  },
  "dependencies": {
    "@fontsource/josefin-sans": "^5.0.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^15",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8",
    "vite": "^5.3.0"
  },
  "build": {
    "appId": "com.juanmsl.cvmanager",
    "productName": "CV Manager",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": null,
      "extendInfo": {
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.juanmsl.cvmanager.cv",
            "UTTypeDescription": "Currículum de CV Manager",
            "UTTypeConformsTo": [
              "public.json",
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "cv"
              ],
              "public.mime-type": [
                "application/x-cv-manager"
              ]
            },
            "UTTypeIconFile": "cv-document.icns"
          }
        ]
      },
      "icon": "build/icon.icns"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "scripts/adhoc-sign.cjs",
    "fileAssociations": [
      {
        "ext": "cv",
        "name": "Currículum de CV Manager",
        "description": "Currículum de CV Manager",
        "role": "Editor",
        "rank": "Owner",
        "icon": "cv-document"
      }
    ]
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
