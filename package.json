{
  "name": "cv-manager",
  "private": true,
  "description": "CV Manager monorepo: macOS desktop app and promotional website.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:desktop": "turbo run dev --filter=@cv-manager/desktop",
    "dev:website": "turbo run dev --filter=@cv-manager/website",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dist:desktop": "turbo run dist --filter=@cv-manager/desktop"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp"
    ]
  }
}
