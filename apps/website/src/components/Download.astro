---
import AppIcon from './AppIcon.astro';
import Icon from './Icon.astro';
import { DOWNLOAD_URL, RELEASES_URL, REPO_URL, SLUGS, useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
---

<section id={SLUGS[lang].download} class="dl" aria-labelledby={`dl-title-${lang}`}>
  <div class="wrap grid">
    <div class="main">
      <AppIcon size={88} />
      <h2 id={`dl-title-${lang}`} class="display h2">{t('dl.title')}</h2>
      <p class="lead">{t('dl.sub')}</p>
      <div class="ctas">
        <a class="btn btn--primary" href={DOWNLOAD_URL}>
          <Icon name="PiDownloadSimple" size={18} />
          {t('cta.download')}
        </a>
        <a class="link" href={RELEASES_URL}>{t('dl.all')}</a>
      </div>
      <h3 class="req-h">{t('dl.req')}</h3>
      <ul class="req">
        <li><Icon name="PiCheck" size={14} />{t('dl.req1')}</li>
        <li><Icon name="PiCheck" size={14} />{t('dl.req2')}</li>
        <li><Icon name="PiCheck" size={14} />{t('dl.req3')}</li>
        <li class="muted"><Icon name="PiInfo" size={14} />{t('dl.req4')}</li>
      </ul>
    </div>

    <div class="first ficha">
      <h3>{t('dl.first')}</h3>
      <p class="first-sub">{t('dl.firstSub')}</p>
      <ol>
        <li>{t('dl.s1')}</li>
        <li>{t('dl.s2')}</li>
        <li>
          {t('dl.s3')}
          <div class="mock" aria-hidden="true">
            <strong>{t('dl.mockTitle')}</strong>
            <p>{t('dl.mockText')}</p>
            <span class="mock-btn">{t('dl.mockButton')}</span>
          </div>
        </li>
      </ol>
    </div>
  </div>

  <div class="wrap">
    <p class="support">
      <Icon name="PiHeart" size={16} />
      <span>{t('dl.support')}</span>
      <a href={REPO_URL}>{t('dl.code')}</a>
    </p>
  </div>
</section>

<style>
  .dl {
    padding: clamp(64px, 8vw, 120px) 0 clamp(48px, 6vw, 80px);
    scroll-margin-top: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .main {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .main .h2 {
    margin-top: 8px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 16px;
  }
  .link {
    font-weight: 500;
    color: var(--plum);
  }
  .req-h {
    margin-top: 24px;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-3);
  }
  .req {
    display: grid;
    gap: 8px;
    font-size: 15px;
  }
  .req li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .req :global(.icon) {
    color: var(--plum);
    transform: translateY(2px);
  }
  .req .muted {
    color: var(--ink-3);
  }
  .req .muted :global(.icon) {
    color: var(--ink-3);
  }

  .first {
    padding: clamp(24px, 3vw, 40px);
  }
  .first h3 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(24px, 2.2vw, 30px);
    line-height: 1.2;
  }
  .first-sub {
    margin-top: 8px;
    color: var(--ink-2);
  }
  ol {
    counter-reset: s;
    display: grid;
    gap: 20px;
    margin-top: 24px;
  }
  ol > li {
    counter-increment: s;
    position: relative;
    padding-left: 40px;
  }
  ol > li::before {
    content: counter(s);
    position: absolute;
    left: 0;
    top: -1px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--tint);
    color: var(--plum);
    font-size: 13px;
    font-weight: 600;
  }
  .mock {
    display: grid;
    gap: 6px;
    justify-items: start;
    margin-top: 14px;
    padding: 14px 16px;
    border-radius: 10px;
    background: var(--window);
    border: 0.5px solid var(--field);
    font-size: 13px;
  }
  .mock p {
    color: var(--ink-2);
  }
  .mock-btn {
    margin-top: 4px;
    padding: 3px 12px;
    border-radius: 6px;
    background: var(--surface);
    border: 0.5px solid var(--field);
    box-shadow: var(--shadow-control);
    font-weight: 500;
  }

  .support {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: clamp(48px, 6vw, 80px);
    padding-top: 24px;
    border-top: 0.5px solid var(--field);
    color: var(--ink-2);
    font-size: 15px;
  }
  .support :global(.icon) {
    color: var(--plum);
  }
  .support a {
    color: var(--plum);
    font-weight: 500;
  }
  @media (max-width: 959px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
