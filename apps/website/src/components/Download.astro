---
// Descarga: una sola tarjeta de dos columnas (diseño de Figma). A la izquierda
// la descarga y los requisitos; a la derecha, los pasos de la primera apertura.
import Icon from './Icon.astro';
import { DOWNLOAD_URL, RELEASES_URL, REPO_URL, SLUGS, useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
---

<section id={SLUGS[lang].download} class="dl" aria-labelledby={`dl-title-${lang}`}>
  <div class="wrap">
    <div class="ficha box">
      <div class="main">
        <h2 id={`dl-title-${lang}`} class="display h2">{t('dl.title')}</h2>
        <p class="lead">{t('dl.sub')}</p>
        <div class="ctas">
          <a class="btn btn--primary" href={DOWNLOAD_URL}>
            <Icon name="PiDownloadSimple" size={18} />
            {t('cta.download')}
          </a>
          <a class="btn btn--secondary" href={RELEASES_URL}>{t('dl.all')}</a>
        </div>
        <h3 class="req-h">{t('dl.req')}</h3>
        <ul class="req">
          <li>{t('dl.req1')}</li>
          <li>{t('dl.req2')}</li>
          <li>{t('dl.req3')}</li>
          <li class="muted">{t('dl.req4')}</li>
        </ul>
      </div>

      <div class="first">
        <h3>{t('dl.first')}</h3>
        <p class="first-sub">{t('dl.firstSub')}</p>
        <ol>
          <li>{t('dl.s1')}</li>
          <li>{t('dl.s2')}</li>
          <li>{t('dl.s3')}</li>
        </ol>
        <div class="mock" aria-hidden="true">
          <p>
            <strong>{t('dl.mockTitle')}</strong> · {t('dl.mockText')}
          </p>
          <span class="mock-btn">{t('dl.mockButton')}</span>
        </div>
      </div>
    </div>

    <p class="support">
      <span>{t('dl.support')}</span>
      <a href={REPO_URL}>{t('dl.code')}</a>
    </p>
  </div>
</section>

<style>
  .dl {
    padding: clamp(64px, 8vw, 120px) 0 clamp(48px, 6vw, 80px);
  }
  .box {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    box-shadow: var(--shadow-soft);
  }
  .box::before {
    background: var(--plum);
  }
  .main {
    display: grid;
    gap: 16px;
    align-content: start;
    justify-items: start;
    padding: clamp(28px, 4vw, 48px);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .req-h {
    margin-top: 16px;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .req {
    display: grid;
    gap: 6px;
    padding-left: 18px;
    list-style: disc;
    font-size: 14px;
  }
  .req li::marker {
    color: var(--ink-3);
  }
  .req .muted {
    color: var(--ink-3);
  }

  .first {
    padding: clamp(28px, 4vw, 48px) clamp(24px, 3vw, 36px);
    background: var(--window);
    border-left: 0.5px solid var(--sep);
  }
  .first h3 {
    font-size: 17px;
    font-weight: 600;
  }
  .first-sub {
    margin-top: 12px;
    color: var(--ink-2);
    font-size: 14px;
  }
  ol {
    counter-reset: s;
    display: grid;
    gap: 16px;
    margin-top: 20px;
  }
  ol > li {
    counter-increment: s;
    position: relative;
    padding-left: 36px;
    font-size: 15px;
  }
  ol > li::before {
    content: counter(s);
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--tint);
    color: var(--plum);
    font-size: 12px;
    font-weight: 600;
  }
  .mock {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
    padding: 14px 16px;
    border-radius: 10px;
    background: var(--surface);
    border: 0.5px solid var(--sep);
    font-size: 12px;
    color: var(--ink-2);
  }
  .mock p {
    flex: 1;
  }
  .mock strong {
    font-weight: 500;
  }
  .mock-btn {
    flex: none;
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid var(--plum);
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
    white-space: nowrap;
  }

  .support {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 24px;
    padding-inline: 4px;
    color: var(--ink-2);
    font-size: 14px;
  }
  .support a {
    color: var(--plum);
    font-weight: 500;
    text-decoration: none;
  }
  .support a:hover {
    text-decoration: underline;
  }

  @media (max-width: 959px) {
    .box {
      grid-template-columns: minmax(0, 1fr);
    }
    .first {
      border-left: 0;
      border-top: 0.5px solid var(--sep);
    }
  }
  @media (max-width: 480px) {
    .ctas .btn {
      flex: 1 1 100%;
    }
    .mock {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
