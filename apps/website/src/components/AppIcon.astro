---
// Ícono de la app (mismo dibujo que apps/desktop/build/icon.svg).
interface Props { size?: number; class?: string }
const { size = 32, class: className } = Astro.props;
const id = 'app-bg-' + Math.random().toString(36).slice(2, 8);
---

<svg class={className} width={size} height={size} viewBox="100 100 824 824" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#77598F" /><stop offset="1" stop-color="#4A3160" /></linearGradient>
  </defs>
  <rect x="100" y="100" width="824" height="824" rx="185" fill={`url(#${id})`} />
  <g transform="translate(292 232) scale(1)"><rect x="0" y="0" width="440" height="560" rx="22" fill="#FFFFFF"/><path d="M22 0 H150 V560 H22 A22 22 0 0 1 0 538 V22 A22 22 0 0 1 22 0 Z" fill="#2F2538"/><circle cx="75" cy="92" r="44" fill="#CDBFD9"/><rect x="34" y="168" width="82" height="12" rx="6" fill="#FFFFFF"/><rect x="34" y="194" width="58" height="9" rx="4.5" fill="#FFFFFF" fill-opacity="0.55"/><rect x="34" y="262" width="70" height="9" rx="4.5" fill="#FFFFFF" fill-opacity="0.55"/><rect x="34" y="284" width="82" height="9" rx="4.5" fill="#FFFFFF" fill-opacity="0.55"/><rect x="34" y="306" width="50" height="9" rx="4.5" fill="#FFFFFF" fill-opacity="0.55"/><rect x="34" y="374" width="82" height="7" rx="3.5" fill="#FFFFFF" fill-opacity=".9"/><rect x="34" y="396" width="64" height="7" rx="3.5" fill="#FFFFFF" fill-opacity=".9"/><rect x="34" y="418" width="74" height="7" rx="3.5" fill="#FFFFFF" fill-opacity=".9"/><g fill="#5B3F73"><rect x="186" y="56" width="120" height="16" rx="8"/><rect x="186" y="84" width="34" height="5" rx="2.5"/><rect x="186" y="222" width="140" height="16" rx="8"/><rect x="186" y="250" width="34" height="5" rx="2.5"/><rect x="186" y="408" width="104" height="16" rx="8"/><rect x="186" y="436" width="34" height="5" rx="2.5"/></g><g fill="#D9D3DE"><rect x="186" y="110" width="218" height="9" rx="4.5"/><rect x="186" y="132" width="200" height="9" rx="4.5"/><rect x="186" y="154" width="150" height="9" rx="4.5"/><rect x="186" y="276" width="218" height="9" rx="4.5"/><rect x="186" y="298" width="184" height="9" rx="4.5"/><rect x="186" y="320" width="208" height="9" rx="4.5"/><rect x="186" y="342" width="120" height="9" rx="4.5"/><rect x="186" y="462" width="218" height="9" rx="4.5"/><rect x="186" y="484" width="170" height="9" rx="4.5"/></g></g>
</svg>
