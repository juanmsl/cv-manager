---
// Ícono de los archivos .cv (mismo dibujo que apps/desktop/build/cv-document.svg).
interface Props { size?: number; class?: string }
const { size = 120, class: className } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
const fold = 'doc-fold-' + uid;
const bg = 'doc-bg-' + uid;
