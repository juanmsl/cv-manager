---
import AppIcon from './AppIcon.astro';
import { LANGS, SLUGS, useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const slug = SLUGS[lang];
const links = [
  [`#${slug.how}`, t('nav.how')],
  [`#${slug.templates}`, t('nav.templates')],
  [`#${slug.privacy}`, t('nav.privacy')],
  [`#${slug.download}`, t('nav.download')],
] as const;
---

<header class="nav">
  <div class="wrap nav-row">
    <a class="brand" href="#top" aria-label={t('nav.home')}>
      <AppIcon size={32} />
      <span>CV Manager</span>
    </a>
    <nav class="links" aria-label="Main">
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <div class="seg lang" role="group" aria-label={t('nav.language')}>
      {
        LANGS.map((l) => (
          <button type="button" lang={l} data-set-lang={l} data-switch="nav" aria-pressed={l === lang ? 'true' : 'false'}>
            {l.toUpperCase()}
          </button>
        ))
      }
    </div>
  </div>
</header>

<style>
  /* Fija arriba al hacer scroll, con el degradado ciruela del ícono de la app */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: linear-gradient(90deg, #4a3160 0%, var(--plum) 55%, #77598f 100%);
    box-shadow:
      0 6px 20px rgb(61 41 77 / 0.28),
      0 1px 2px rgb(0 0 0 / 0.08);
    color: #fff;
  }
  .nav :focus-visible {
    outline-color: #fff;
  }
  .nav-row {
    display: flex;
    align-items: center;
    gap: 36px;
    min-height: var(--nav-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-right: auto;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 24px;
    letter-spacing: 0.02em;
    border-radius: 8px;
  }
  .brand :global(svg) {
    filter: drop-shadow(0 2px 6px rgb(31 15 41 / 0.45));
  }
  .links {
    display: flex;
    gap: 32px;
  }
  .links a {
    color: rgb(255 255 255 / 0.82);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    border-radius: 4px;
  }
  .links a:hover {
    color: #fff;
  }
  .lang {
    background: rgb(255 255 255 / 0.14);
  }
  .lang button {
    padding: 4px 10px;
    border: 0;
    background: none;
    color: rgb(255 255 255 / 0.82);
    cursor: pointer;
  }
  .lang button[aria-pressed='true'] {
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.1);
  }
  .lang button:hover:not([aria-pressed='true']) {
    color: #fff;
  }
  @media (max-width: 900px) {
    .links {
      display: none;
    }
    .brand {
      font-size: 20px;
    }
    .nav-row {
      min-height: var(--nav-h);
    }
  }
</style>
